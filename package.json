{
  "name": "calis30",
  "version": "1.1.0",
  "private": true,
  "description": "Calis30: progressive calisthenics app (30-Day Beginner Matrix and 3-Month Skill Roadmap). Static site, no runtime dependencies.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --minify",
    "check": "node scripts/security-check.js",
    "test": "node tests/run-all.js",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "jsdom": "30.1.3",
    "tailwindcss": "3.4.17"
  }
}
